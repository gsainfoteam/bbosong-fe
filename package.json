{
  "name": "bbosong-fe",
  "version": "0.0.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "bun run gen:api && bun run gen:i18n && tsr generate && tsc && vite build",
